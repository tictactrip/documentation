    {
      "name": "15. Webhooks",
      "description": "Register the urls we POST an event on at each change of your carts and orders. See https://developers.tictactrip.eu/docs/webhooks",
      "item": [
        {
          "name": "1. Register a webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer token"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://api.tictactrip.eu/booking/v3/webhooks",
              "protocol": "https",
              "host": [
                "api",
                "tictactrip",
                "eu"
              ],
              "path": [
                "booking",
                "v3",
                "webhooks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"url\": \"https://partner.example/tictactrip/webhook\"\n}"
            },
            "description": "A public https url, 5 at most. Copy the returned `webhook.id` into the `webhook_id` variable."
          },
          "response": []
        },
